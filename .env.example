# IA: auto (Claude si hay ANTHROPIC_API_KEY, si no simulada) | claude | mock
QA_AI=auto
# ANTHROPIC_API_KEY=sk-ant-...
QA_CLAUDE_MODEL=claude-opus-5-5
QA_MAX_FIX_ATTEMPTS=2

# Azure DevOps: por defecto el simulador local. Para el real:
# AZURE_BASE_URL=https://dev.azure.com
# AZURE_ORG=<organización>
# AZURE_PROJECT=<proyecto>
# AZURE_REPO=<repositorio de tests>
# AZURE_PAT=<token con permisos Work Items, Test Management y Code>
AZURE_PAT=pat-demo-poc

# Web bajo prueba
# DEMO_SITE_URL=http://localhost:8602

# SDK de .NET si no está en ~/.dotnet ni en el PATH
# DOTNET=/usr/bin/dotnet
