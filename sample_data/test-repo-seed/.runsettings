<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <BASE_URL>http://localhost:8602</BASE_URL>
    </EnvironmentVariables>
  </RunConfiguration>
  <Playwright>
    <BrowserName>chromium</BrowserName>
